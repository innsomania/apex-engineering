diff --git a/durations.py b/durations.py
index 888cb05..8761d21 100644
--- a/durations.py
+++ b/durations.py
@@ -3,7 +3,7 @@
 import re
 
 _UNITS = {"h": 3600, "m": 60, "s": 1}
-_PART = re.compile(r"(\d+)([hms])")
+_DURATION = re.compile(r"(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?")
 
 
 def parse_duration(text: str) -> int:
@@ -12,8 +12,11 @@ def parse_duration(text: str) -> int:
     Units are h, m and s, each at most once, largest first: "2h", "90m", "1h5s", "1h1m1s".
     Anything else, including the empty string, raises ValueError.
     """
-    match = _PART.search(text)
-    if not match:
+    match = _DURATION.fullmatch(text)
+    if not match or not any(match.groups()):
         raise ValueError(f"invalid duration: {text!r}")
-    value, unit = match.groups()
-    return int(value) * _UNITS[unit]
+    return sum(
+        int(value) * _UNITS[unit]
+        for value, unit in zip(match.groups(), ("h", "m", "s"))
+        if value is not None
+    )
diff --git a/test_durations.py b/test_durations.py
index a9264ad..0f4dd5a 100644
--- a/test_durations.py
+++ b/test_durations.py
@@ -7,6 +7,17 @@ class ParseDurationTests(unittest.TestCase):
     def test_single_unit(self):
         self.assertEqual(parse_duration("45s"), 45)
 
+    def test_composite_units(self):
+        self.assertEqual(parse_duration("1h30m"), 5400)
+        self.assertEqual(parse_duration("1h5s"), 3605)
+        self.assertEqual(parse_duration("1h1m1s"), 3661)
+        self.assertEqual(parse_duration("90m"), 5400)
+
+    def test_invalid_durations(self):
+        for text in ("", "1m1h", "1h1h", "1hxyz", "1h30"):
+            with self.subTest(text=text), self.assertRaises(ValueError):
+                parse_duration(text)
+
 
 if __name__ == "__main__":
     unittest.main()
